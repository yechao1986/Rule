name: "微信去广告"
desc: "微信朋友圈、公众号文章及信息流广告拦截；需要开启 Stash MiTM"
category: "去广告"

http:

  # ============================================================
  # MiTM
  # ============================================================
  #
  # 用于识别 HTTPS 下的微信广告请求。
  #
  # 前提：
  # Stash → 设置 → MitM → 安装并信任 CA 证书
  #
  mitm:
    - "mp.weixin.qq.com"
    - "*.wxs.qq.com"

  # ============================================================
  # URL Rewrite
  # ============================================================
  #
  # 对明确的广告接口直接返回空字典。
  #
  url-rewrite:

    # ----------------------------------------------------------
    # 微信公众号文章广告
    # ----------------------------------------------------------

    # 文章广告
    - ^https:\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad\?.* - reject-dict

    # 公众号商品 / CPS 推广
    - ^https:\/\/mp\.weixin\.qq\.com\/mp\/cps_product_info\?.* - reject-dict

    # 公众号信息流
    - ^https:\/\/mp\.weixin\.qq\.com\/mp\/masonryfeed\?.* - reject-dict

    # 相关推荐
    - ^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedarticle\?.* - reject-dict

    # ----------------------------------------------------------
    # 微信文章推广资源
    # ----------------------------------------------------------

    - ^https?:\/\/\w+\.wxs\.qq\.com\/\d+\/\d+\/(snscosdownload|snssvpdownload)\/(SH|SZ)\/reserved\/\w+.* - reject-dict

    # ----------------------------------------------------------
    # 视频号/发现页相关推广资源
    # ----------------------------------------------------------

    - ^http:\/\/[\d\.]+(:49155)?\/finderpdd\.video\.qq\.com\/\d+\/\d+\/stodownload\?.* - reject-dict


  # ============================================================
  # Body Rewrite
  # ============================================================
  #
  # 对 JSON 响应中的常见广告字段进行删除。
  #
  # 这一部分属于“增强模式”。
  # 如果微信某次更新导致公众号内容异常，可以先删除这一段，
  # 只保留上面的 URL Rewrite。
  #
  body-rewrite:

    # ----------------------------------------------------------
    # 公众号文章广告接口
    # ----------------------------------------------------------

    - '^https:\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad\?.* response-jq del(.advertisement) | del(.advertisements) | del(.ad) | del(.ads) | del(.ad_info) | del(.adInfo)'

    # ----------------------------------------------------------
    # 公众号信息流
    # ----------------------------------------------------------

    - '^https:\/\/mp\.weixin\.qq\.com\/mp\/masonryfeed\?.* response-jq del(.ad) | del(.ads) | del(.advertisement) | del(.advertisements)'

    # ----------------------------------------------------------
    # 公众号相关推荐
    # ----------------------------------------------------------

    - '^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedarticle\?.* response-jq del(.ad) | del(.ads) | del(.advertisement) | del(.advertisements)'


# ==============================================================
# 微信朋友圈广告
# ==============================================================

rules:

  # 朋友圈广告图片
  - DOMAIN,wxsnsdy.wxs.qq.com,REJECT-DROP

  # 朋友圈广告缩略图
  - DOMAIN,wxsnsdythumb.wxs.qq.com,REJECT-DROP
